<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->

	<app title="Friday Night Funkin': Vs Animation" file="VsAnimation" main="MainApplication" path="source" packageName="com.vsanimation.psychengine" package="com.vsanimation.psychengine" version="0.2.7" company="ShadowMario" />
	<set name="APP_ID" value="0x0100f6c013bbc000" />
	<app preloader="flixel.system.FlxPreloader" />
	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" />
	<window if="html5" resizable="true" />
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false"/>
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="true" />
	<window if="mobile" orientation="landscape" fullscreen="true" resizable="false" allow-shaders="true" require-shaders="true" allow-high-dpi="true" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />

	<classpath name="source" />

	<assets path="assets/preload" rename="assets" />
	<assets path="assets/fonts" embed='true'/>
	<assets path="assets/videos"        library="videos"        if="VIDEOS_ALLOWED"/>
	<assets path="assets/songs"         library="songs"         exclude="*.ogg" if="web"/>
	<assets path="assets/songs"         library="songs"         exclude="*.mp3" unless="web"/>
	<assets path="assets/shared"        library="shared"        exclude="*.ogg" if="web"/>
	<assets path="assets/shared"        library="shared"        exclude="*.mp3" unless="web"/>
	<assets path="assets/week6"         library="week6"         exclude="*.ogg" if="web"/>
	<assets path="assets/week6"         library="week6"         exclude="*.mp3" unless="web"/>
	<assets path="assets/videos" exclude="*.mp3" if="web"/>
    <assets path="assets/videos" exclude="*.ogg" unless="web"/>
	<assets path="example_mods" rename="mods" embed="true" if="MODS_ALLOWED"/>
	<assets path="art/readme.txt" rename="do NOT readme.txt" />

	<define name="PRELOAD_ALL" unless="web" />
	<define name="NO_PRELOAD_ALL" unless="PRELOAD_ALL"/>
	<library name="videos"        preload="true" />
	<section if="PRELOAD_ALL">
		<library name="songs"         preload="true" />
		<library name="shared"        preload="true" />
		<library name="week6"         preload="true" />
	</section>

	<section if="NO_PRELOAD_ALL">
		<library name="songs"         preload="false" />
		<library name="shared"        preload="false" />
		<library name="week6"         preload="false" />
	</section>
	
	<!-- PSYCH ENGINE CUSTOMIZATION -->
	<define name="MODS_ALLOWED" if="desktop || mobile" />
	<define name="LUA_ALLOWED" if="desktop || mobile" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="VIDEOS_ALLOWED" if="web || windows || android" unless="32bits"/>
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="FLX_NO_DEBUG" unless="debug" />
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	<define name="TOUCH_CONTROLS" if="mobile || web"/>
	<!-- <define name="PSYCH_WATERMARKS"/> DELETE THIS TO REMOVE WATERMARKS ON TITLE SCREEN -->

	<!-- ____________________________ Android Setup _____________________________ -->

	<target name="android" />
	<set name="android.minapi" value="19" />
	<set name="android.target-sdk-version" value="33" />
	<set name="android.ndk" value="21.3.6528147" />

	<!-- _____________________________ OPTIMIZATIONS ____________________________ -->

	<haxedef name="HXCPP_FLOAT32" />
	<haxedef name="HXCPP_GC_BIG_BLOCKS"/>
	<haxedef name="HXCPP_CHECK_POINTER" if="release" />
	<haxedef name="HXCPP_STACK_LINE" if="release" />
	<haxedef name="HXC_LIBVLC_LOGGING" if="debug" />
	<haxedef name="HXC_DEBUG_TRACE" if="debug" />

	<!-- __________________________ Mandatory libraries __________________________ -->

    <haxelib name="flixel" />
	<haxelib name="flixel-addons" />
	<haxelib name="flixel-ui" />
	<haxelib name="openfl" />
	<haxelib name="lime" />
	<haxelib name="hscript" />
	<haxelib name="hxCodec" />
	<haxelib name="actuate" />
	<haxelib name="hxcpp" />
    <haxelib name="extension-webm" if="desktop" />
	<haxelib name="extension-androidtools" if="mobile" />
	<haxelib name="linc_luajit" if="LUA_ALLOWED"/>
	<haxelib name="faxe" if='switch'/>
	<haxelib name="discord_rpc" if="desktop"/>
	<!-- <haxelib name="flixel-tools" /> really needs? -->
	<!-- <haxedev set='webgl' /> this really needs? -->

	<!-- ____________________________ Apk Signed Sign ____________________________ -->

	<certificate path="key.keystore" password="sourcingurpassword" alias="sourcingurkey" alias-password="sourcingurpassword" if="android" unless="debug" />

	<!-- _________________________________ Icons _______________________________ -->
	
	<icon path="art/icon16.png" size='16'/>
	<icon path="art/icon32.png" size='32'/>
	<icon path="art/icon64.png" size='64'/>
	<icon path="art/iconOG.png" />

	<!-- ___________________________ Include Custom Libs _______________________ -->

	<include name="libs-mobile.xml" /> <!-- Mobile -->
</project>
